# Copy to .env (gitignored), `make push` uploads it. No real values in git.

# Cover site; its A record must point at the server before `make cert`.
DOMAIN=cover.example.org

# Secret path of the relay, the same as `path` in the client's endpoint list.
# Random, at least 8 characters: echo "/$(openssl rand -hex 12)"
VPN_PATH=

# Issuer key pair from `make keygen`. Every server gets the SAME pair (copy it
# from an existing server's .env): a device renews its credential at any
# server, and credentials of one server are valid on all.
ISSUER_KEY=
CRED_PUB=

# Play Integrity: put the service account key into relay/data/sa.json on the server
# (optional; without it devices register by invite code only).
APP_PACKAGE=org.newvpn

# Limits, empty = relay defaults (4096 connections, 128 per device).
MAX_CONNS=
MAX_CONNS_PER_DEVICE=
