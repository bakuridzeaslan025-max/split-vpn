<?xml version="1.0" encoding="utf-8"?>
<!-- Roles after Material 3; the dark theme overrides the values, not the names. -->
<resources>
    <color name="ic_launcher_background">#1565C0</color>

    <color name="background">#F2F2F2</color>
    <color name="surface_lowest">#FFFFFF</color>
    <color name="surface_container">#EEEEEE</color>
    <color name="surface_container_high">#E4E4E4</color>
    <color name="surface_container_highest">#DADCE0</color>
    <color name="on_surface">#1F1F1F</color>
    <color name="on_surface_variant">#5E5E5E</color>
    <color name="outline">#8E918F</color>
    <color name="outline_variant">#E3E3E3</color>

    <color name="primary">#1A73E8</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="primary_container">#E3ECFB</color>
    <color name="on_primary_container">#0B4AA6</color>

    <color name="error_container">#FBE6E6</color>
    <color name="on_error_container">#8C1D18</color>

    <color name="success">#1E8E3E</color>
    <color name="success_container">#E3F2E7</color>
    <color name="on_success_container">#0D5C26</color>
    <color name="warning">#F29900</color>
    <color name="warning_container">#FDF5DA</color>
    <color name="on_warning_container">#6B4A00</color>

    <!-- The connect button. Refers to primary; if #8AB4F8 proves too bright
         on a big button in the dark, the fallback is #1A73E8 / #FFFFFF there. -->
    <color name="main_button">@color/primary</color>
    <color name="on_main_button">@color/on_primary</color>
    <color name="menu_container">#FFFFFF</color>
    <color name="menu_item_selected">#EEEEEE</color>
    <color name="switch_thumb_off">#FFFFFF</color>
    <!-- White in both themes: the QR's quiet zone, scanners expect it. -->
    <color name="qr_backing">#FFFFFF</color>
    <!-- Black under the dialogs. -->
    <fraction name="scrim">32%</fraction>

</resources>
