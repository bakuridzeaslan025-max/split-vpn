<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/simple_dialog"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Разрешите обновления"
        android:textSize="20sp"
        android:textColor="@color/simple_ink" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingMultiplier="1.2"
        android:text="Чтобы Split VPN мог сам ставить свои обновления, Android попросит разрешение на установку приложений. На следующем экране включите переключатель и вернитесь назад."
        android:textSize="14sp"
        android:textColor="@color/simple_dim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end">

        <TextView
            android:id="@+id/cancel"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:fontFamily="sans-serif-medium"
            android:text="Отмена"
            android:textSize="14sp"
            android:textColor="@color/simple_link" />

        <TextView
            android:id="@+id/apply"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/simple_blue_pill"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:fontFamily="sans-serif-medium"
            android:text="Продолжить"
            android:textSize="14sp"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</LinearLayout>
