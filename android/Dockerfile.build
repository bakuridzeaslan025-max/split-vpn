# The Makefile runs the Go tests in this same image.
ARG GO_IMAGE=golang:1.27.1-trixie@sha256:433790e515d27dc6003e847e644cc0af956985cf315c1c58a3b73ee2dd305183
FROM --platform=linux/amd64 $GO_IMAGE

RUN apt-get update && apt-get install -y --no-install-recommends unzip wget default-jdk-headless && \
    rm -rf /var/lib/apt/lists/*

# Android SDK command-line tools
ENV ANDROID_HOME=/opt/android-sdk
RUN mkdir -p $ANDROID_HOME/cmdline-tools && \
    wget -q https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip -O /tmp/tools.zip && \
    echo "2d2d50857e4eb553af5a6dc3ad507a17adf43d115264b1afc116f95c92e5e258  /tmp/tools.zip" | sha256sum -c - && \
    unzip -q /tmp/tools.zip -d $ANDROID_HOME/cmdline-tools && \
    mv $ANDROID_HOME/cmdline-tools/cmdline-tools $ANDROID_HOME/cmdline-tools/latest && \
    rm /tmp/tools.zip

ENV PATH=$PATH:$ANDROID_HOME/cmdline-tools/latest/bin

# Accept licenses and install the platform
RUN yes | sdkmanager --licenses > /dev/null 2>&1 || true
RUN sdkmanager "platforms;android-26"

# NDK as a plain zip, since sdkmanager checks only SHA-1. Google publishes
# only SHA-1 for it (090e8083a715fdb1a3e402d0763c388abb03fb4e in
# repository2-3.xml), the SHA-256 is of that same file.
ENV ANDROID_NDK_HOME=$ANDROID_HOME/ndk/27.2.12479018
RUN mkdir -p $ANDROID_HOME/ndk && \
    wget -q https://dl.google.com/android/repository/android-ndk-r27c-linux.zip -O /tmp/ndk.zip && \
    echo "59c2f6dc96743b5daf5d1626684640b20a6bd2b1d85b13156b90333741bad5cc  /tmp/ndk.zip" | sha256sum -c - && \
    unzip -q /tmp/ndk.zip -d $ANDROID_HOME/ndk && \
    mv $ANDROID_HOME/ndk/android-ndk-r27c $ANDROID_NDK_HOME && \
    rm /tmp/ndk.zip

# gomobile: the golang.org/x/mobile version from tunnel/go.mod (the Makefile passes it)
ARG XMOBILE
RUN go install golang.org/x/mobile/cmd/gomobile@$XMOBILE && \
    go install golang.org/x/mobile/cmd/gobind@$XMOBILE && \
    gomobile init

WORKDIR /src
