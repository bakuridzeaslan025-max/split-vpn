# Copy to .env.mk (gitignored) for make deploy/restart/invite. ?= lets the
# environment override it.
# Every relay VDS, space-separated; invite/deploy/restart go to all of them.
SSH_HOSTS ?= root@203.0.113.10 root@203.0.113.11
# Dir with docker-compose.yml on each VDS; the binary goes to relay/relay in it.
REMOTE_DIR ?= /opt/vpn
